# Copy this file to secrets.yaml next to your ESPHome configuration and fill in
# your own values. secrets.yaml itself must never be committed.
#
# Generate a fresh key with:  openssl rand -base64 32
#
# If you are updating an existing device, put the key it already uses here.
# A different key means Home Assistant can no longer talk to the device and
# you have to re-add it manually.
api_encryption_key: "REPLACE_ME_WITH_YOUR_OWN_32_BYTE_BASE64_KEY"
